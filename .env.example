# ── Excido API configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# Vite only exposes vars prefixed with VITE_ to the browser.

# Required. Your Excido API key — sent as the "X-API-Key" header.
VITE_EXCIDO_API_KEY=your_api_key_here

# Required. Your Excido account email — sent as the "X-User-Email" header.
VITE_EXCIDO_USER_EMAIL=you@example.com

# API origin.
#  • Local dev: use the Vite proxy path below to avoid CORS.
#  • Production: set the real origin, e.g. https://api.excido.app
VITE_EXCIDO_API_BASE=/excido
